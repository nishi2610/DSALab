#include<stdio.h>
struct Queue{
    int arr[20];
    int front,rear;
    };
struct Queue q;
int isEmpty();
int isFull();
void enqueue(int newele);
void dequeue();
void peek();
void traverse();
int main(){
    int newele,a,n=0;
    q.front=-1;
    q.rear=-1;
    while(n==0){
    printf("What Queue operations do you want to perform??\n1.ENQUEUE\n2.DEQUEUE\n3.PEEK\n4.TRAVERSE\n5.EXIT\n");
    scanf("%d",&a);
    switch(a){
    case 1:
        printf("enter element:");
        scanf("%d",&newele);
        enqueue(newele);
        break;
    case 2:
        dequeue();
        break;
    case 3:
        peek();
        break;
    case 4:
        traverse();
        break;
    case 5:
        n=1;
        break;
    default:
        printf("INVALID INPUT!!");
        break;}}
    return 0;}
int isEmpty(){
    if(q.front==-1)
        return 1;
    return 0;
    }
int isFull(){
    if(q.rear==19)
        return 1;
    return 0;
    }
void enqueue(int newele){
    if(isFull())
        printf("The Queue is Full!!");
    else if(isEmpty()){
        q.front=0;
        q.arr[++q.rear]=newele;
    }
    else
        q.arr[++q.rear]=newele;
    }
void dequeue(){
    if(isEmpty())
        printf("The Queue is Empty!!");
    else if(q.rear==q.front){
        q.front=-1;
        q.rear=-1;
    }
    else
        printf("dequeued element is: %d\n: ",q.arr[q.front++]);
    }
void peek(){
    if(isEmpty())
        printf("The Queue is Empty!!");
    else
        printf("The front element is: %d\n: ", q.arr[q.front]);
}
void traverse(){
    if(isEmpty())
        printf("The Queue is Empty!!");
    else{
        printf("The queue is:\n");
        for(int i=q.front;i<=q.rear;i++)
            printf("%d\n", q.arr[i]);
    }
}
